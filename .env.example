# Copia este archivo como .env y pega allí tu token de Apify.
# El archivo .env está excluido de Git. No compartas el token por chat.
APIFY_API_TOKEN=

# Máximo de ofertas que trae la búsqueda de LinkedIn en cada corrida.
# Opcional: si lo borrás, el servidor usa 200.
# El valor se acota siempre entre 20 y 1000 (si ponés algo fuera de ese rango,
# se ajusta al límite más cercano). Ojo: cada búsqueda EJECUTA un actor de Apify
# y se factura por ejecución, así que subirlo de 200 cuesta plata de verdad.
# Si el frontend manda un "limit" en el body de POST /api/linkedin-search, ese
# valor gana sobre este (sigue estando acotado al mismo rango).
APIFY_MAX_RESULTS=200
